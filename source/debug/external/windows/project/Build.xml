<?xml version="1.0" encoding="UTF-8"?>
<xml>
  <pragma once="true" />

  <files id="haxe">
    <compilerflag value="-I${this_dir}/include" />
  </files>

  <files id="__main__">
    <compilerflag value="-I${this_dir}/include" />
  </files>

  <files id="external-windows">
    <compilerflag value="-I${this_dir}/include" />

    <file name="${this_dir}/src/winapi.cpp" />
  </files>

  <target id="haxe">
    <section if="mingw">
      <lib name="-luser32" />
      <lib name="-lkernel32" />
      <lib name="-ldwmapi" />
      <lib name="-ladvapi32" />

      <lib name="-ldwmapi"  />
      <lib name="-lshell32"  />
      <lib name="-lgdi32" />
      <lib name="-lole32" />
      <lib name="-luxtheme"  />
    </section>

    <section unless="mingw">
      <lib name="user32.lib" />
      <lib name="kernel32.lib" />
      <lib name="dwmapi.lib" />
      <lib name="advapi32.lib" />

      <lib name="dwmapi.lib"  />
      <lib name="shell32.lib" />
      <lib name="gdi32.lib"  />
      <lib name="ole32.lib" />
      <lib name="uxtheme.lib" />
    </section>

    <files id="external-windows" />
  </target>
</xml>